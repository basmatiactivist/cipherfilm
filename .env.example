# Copy to .env and edit. docker compose reads it automatically.

# 1. Choose how to deploy: exactly one overlay.
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
#COMPOSE_FILE=compose.yaml:compose.proxy.yaml
#COMPOSE_FILE=compose.yaml:compose.caddy.yaml

# --- Tailscale (compose.tailscale.yaml) ---
# Auth key from https://login.tailscale.com/admin/settings/keys (a one-off key is fine: it is only used for the first login).
TS_AUTHKEY=
# The machine name; your site becomes https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=photos

# --- Own reverse proxy (compose.proxy.yaml) ---
#APP_PORT=8080
#TRUST_PROXY=1

# --- Caddy with automatic HTTPS (compose.caddy.yaml) ---
#SITE_ADDRESS=photos.example.com

# --- Kopia off-site backups (compose.kopia.yaml, add it to COMPOSE_FILE) ---
# Login for the Kopia UI (user admin). Keep the single quotes, or a $ in it is read as a variable.
#KOPIA_SERVER_PASSWORD=''

# --- Optional ---
# Use a released image instead of building from source (:1 follows every 1.x release).
#CIPHERFILM_IMAGE=ghcr.io/basmatiactivist/cipherfilm:2
# Name of the Docker volume that holds the database and the encrypted files.
#DATA_VOLUME=cipherfilm_data

# --- Any option: the name(s) people use to reach the app, e.g. photos.example.com or photos.<tailnet>.ts.net ---
# Requests for any other name are refused (protects against DNS rebinding). Leave empty to accept any name.
#PUBLIC_HOSTS=photos.example.com
