{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@crypto/*": [
        "../web/src/crypto/*"
      ],
      "libsodium-wrappers-sumo": [
        "./src/crypto/libsodium.ts"
      ],
      "libsodium-wrappers": [
        "./src/crypto/libsodium.ts"
      ],
      "@places/*": [
        "../web/src/places/*"
      ],
      "@memories/*": [
        "../web/src/memories/*"
      ],
      "@cleanup/*": [
        "../web/src/cleanup/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../web/src/crypto/*.ts",
    "../web/src/places/places.ts",
    "../web/src/places/videoLocation.ts",
    "../web/src/memories/memories.ts",
    "../web/src/cleanup/duplicates.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "../web/src/crypto/*.test.ts",
    "../web/src/crypto/kdf.worker.ts",
    "../web/src/crypto/kdf-async.ts",
    "../web/src/crypto/sodium-sumo.ts"
  ]
}
