# Copy to .env and edit. docker compose reads it automatically.
# Cipherfilm needs HTTPS in front: any reverse proxy, pointed at http://127.0.0.1:8080 (docs/SELF-HOSTING.md).

# Required: the name(s) your proxy serves, comma-separated. Requests for any other name are refused.
PUBLIC_HOSTS=photos.example.com

# 1: exactly one proxy in front that adds X-Forwarded-For. 0: a chain of proxies, a Cloudflare Tunnel or Tailscale Serve.
#TRUST_PROXY=1
# Proxies whose X-Forwarded-For is believed (addresses or CIDRs, comma-separated). Empty: loopback and private networks.
#TRUSTED_PROXIES=
# The port on 127.0.0.1 your proxy connects to.
#APP_PORT=8080

# --- Optional ---
# Use a released image instead of building from source (:2 follows every 2.x release).
#CIPHERFILM_IMAGE=ghcr.io/basmatiactivist/cipherfilm:2
# Name of the Docker volume that holds the database and the encrypted files.
#DATA_VOLUME=cipherfilm_data
